        "The stratified sampling function used in the project:"
      ],
      "id": "46c22691"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "\n",
        "import re\n",
        "\n",
        "def stratified_sample(hf_dataset, n_per_class, seed=42):\n",
        "    \"\"\"\n",
        "    Balanced subsample from a HuggingFace dataset.\n",
        "    Labels kept as-is: 0 = Risk (negative), 1 = Non-Risk (positive).\n",
        "    \"\"\"\n",
        "    import pandas as pd\n",
        "    df = hf_dataset.to_pandas()\n",
        "    if \"sentence\" in df.columns:\n",
        "        df = df.rename(columns={\"sentence\": \"text\"})\n",
        "    df = df[[\"text\", \"label\"]].copy()\n",
        "    df = df[df[\"label\"] != -1].reset_index(drop=True)\n",
        "    df[\"label\"] = df[\"label\"].astype(int)\n",
        "    n = min(n_per_class, df.groupby(\"label\").size().min())\n",
        "    return pd.concat([\n",
        "        df[df[\"label\"] == lv].sample(n=n, random_state=seed)\n",
        "        for lv in sorted(df[\"label\"].unique())\n",
        "    ]).reset_index(drop=True)\n",
        "\n",
        "# Usage (requires HuggingFace token and internet):\n",
        "# dataset  = load_dataset(\"yelp_polarity\", token=hf_token)\n",
        "# train_df = stratified_sample(dataset[\"train\"], 1000, seed=42)\n",
        "# test_df  = stratified_sample(dataset[\"test\"],  250,  seed=42)\n",
        "\n",
        "print(\"stratified_sample() — balances classes and fixes sst2 column naming\")\n",
        "print(\"  Input : HuggingFace dataset split, n_per_class, random seed\")\n",
        "print(\"  Output: balanced pandas DataFrame with 'text' and 'label' columns\")"
      ],
